#!/usr/bin/env bash
# ©AngelaMos | 2026
# template

set -euo pipefail

command -v python3 >/dev/null 2>&1 || {
    printf '%s\n' 'template requires Python 3.10 or newer' >&2
    exit 1
}

tool="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().with_name("cli.py"))' "${BASH_SOURCE[0]}")"
exec python3 -B "$tool" "$@"
